# Скопируй в .env и заполни реальными значениями. Не коммить .env в git!

# Neo4j (графовая БД для Graphiti)
NEO4J_PASSWORD=change_me_to_strong_password

# Deepseek — массовая обработка / извлечение фактов
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# Anthropic Claude — сложные решения
ANTHROPIC_API_KEY=

# Существующий Postgres/pgvector из Phase 1 (для справки, не используется
# напрямую этим docker-compose — оставлен для скриптов экспорта)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brain
POSTGRES_USER=
POSTGRES_PASSWORD=
